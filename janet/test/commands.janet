(use judge)
(use ../src/gurp)
(use ../src/command-lib)

(deftest list-doers
  (test
    (strip-ansi (list-doers))
    @"                       apk  Install and uninstall APK packages. Only\n                            valid in an Alpine LX zone.\n                    bridge  Create and modify ethernet bridges.\n                      cron  Manage cron jobs. Crontab entries are\n                            prefixed with a machine-generated string.\n                 directory  Create and remove directories. Parents are\n                            created like `mkdir -p`, but with the\n                            owner/group/mode of the gurp process. Removal\n                            always removes directory contents.\n                 etherstub  Create and destroy etherstubs.\n                 file-line  Ensure lines do or do not exist in the\n                            given file.\n                      file  Create files from multiple sources, or\n                            remove them.\n                       gem  Install and uninstall Ruby gems.\n                     group  Create and destroy Unix groups.\n                ip-address  Manages IP addresses via ipadm.\n              ip-interface  Create and destroy IP interfaces, with\n                            optional properties.\n             ip-properties  Sets global IP properties, via 'ipadm\n                            set-prop'.\n                  ipfilter  Set or remove ipfilter rules.\n                     ipnat  Set or remove NAT rules.\n                      link  Create and remove links.\n                      misc  A collection of things too small to deserve\n                            their own doer.\n              network-flow  Manage network flows via flowadm.\n                       pkg  Install and uninstall pkg(5) packages.\n                     pkgin  Install and uninstall pkgin packages. Only\n                            valid in a pkgsrc zone.\n                 publisher  Add and remove pkg(5) publisher origins.\n                     route  Manage routes. Note that default routes for\n                            zones should be handled by the zone's :defrouter\n                            property.\n                       smf  Create and install a manifest for an SMF\n                            service.\n                       svc  Manage the state of an existing SMF\n                            service.\n                   svcprop  Set and remove properties and property\n                            groups of an existing SMF service.\n               system-cert  Add and remove system TLS certificates\n                      user  Manage Unix users\n                      vlan  Manage VLAN objects\n                      vnic  Manage VNIC objects\n                       zfs  Create, destroy, and modify properties of\n                            ZFS filesystems.\n                      zone  Create and destroy zones. Existing zones\n                            cannot be modified."))
    

(deftest help-for-doer
  (test
    (strip-ansi (help-for "bridge"))
    @"bridge\n\n  Create and modify ethernet bridges.\n\n  name  [:string]  Any valid bridge name\n\nbridge/ensure\n\nMandatory properties\n  priority       [:number]  Bridge priority. 0 to 61440. Default:\n                            `32768`.\n  max-age        [:number]  Maximum age, in seconds, for STP\n                            configuration information. Default: `20`.\n  protect        [:string]  Protection method. Default: `\"stp\"`.\n  hello-time     [:number]  STP hello time value, in seconds. Default:\n                            `2`.\n  forward-delay  [:number]  STP forward delay time, in seconds. 4 to\n                            30. Default: `15`.\n  force-protocol [:number]  MSTP forced maximum supported protocol.\n                            Default: `3`.\n\nOptional properties\n  links [:tuple]  Existing links which should be attached to the\n                  bridge.\n\nbridge/remove\n\nMandatory properties\n  None\n\nOptional properties\n  None\n\nExamples\n\n  (bridge/ensure \"basic\")\n  \n  (bridge/ensure \"with_links\"\n                 :links [\"stub1\" \"stub2\"]\n                 :priority 4096\n                 :max-age 27)\n  \n\n\n  (bridge/remove \"unwanted\")\n  "))

(deftest help-for-helper
  (test
    (strip-ansi (help-for "zone/network"))
    @"zone/network\n\n  Describe network configuration of a zone resource.\n\n  name  [:string]  Zone VNIC, which may already exist\n\nMandatory properties\n  global-nic [:string]  Physical NIC on which to create zone VNIC.\n                        Default: `\"auto\"`.\n\nOptional properties\n  allowed-address [:string]  IP address, with /netmask.\n  defrouter       [:string]  IP address of default router.\n\nExamples\n\n  (zone/network \"znet0\"\n                :global-nic \"e1000g1\"\n                :allowed-address \"192.168.1.103/24\"\n                :defrouter \"192.168.1.1\")\n  "))
