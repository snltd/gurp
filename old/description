(file/is "/tmp/test_file"
# from should handle templates and literal files
# if you have :content and :from, that's an error
  :from "file_template"
  :owner "root"
  :group "root"
  :values { :word "merp" :gibbus "gurp" })

(file/is "/tmp/file_from_string"
  :content "this is the content"
)

